# Files and folders that must not ship to the WordPress.org SVN / plugin ZIP.
/.git
/.github
/.gitignore
/.distignore
# Directory artwork (icon, banner, screenshots): the deploy action syncs this
# folder to the SVN assets/ directory, it must not end up inside the plugin.
/.wordpress-org
/bin
/node_modules
/vendor
/README.md
*.zip
# Translations are managed by translate.wordpress.org; the PO/MO sources stay
# in the repo only as the import base for the language packs.
/languages
