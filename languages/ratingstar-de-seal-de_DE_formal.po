#: includes/class-ratingstar-settings.php:431
#: blocks/seal/editor.js:56
msgid "Top left"
msgstr "Oben links"

#: includes/class-ratingstar-settings.php:445
msgid "Screen corner for the floating profile card; the footer bar ignores this."
msgstr "Bildschirm-Ecke für die schwebende Profil-Karte; die Footer-Bar ignoriert diese Einstellung."

#: includes/class-ratingstar-settings.php:461
msgid "Optional appearance overrides as key=value pairs — copy them from the embed generator in your RatingStar portal; the data- prefix may be included or left out."
msgstr "Optionale Darstellungs-Overrides als key=value-Paare — kopieren Sie sie aus dem Embed-Generator in Ihrem RatingStar-Portal; das data--Präfix kann mitkopiert oder weggelassen werden."

#: blocks/seal/editor.js:52
msgid "Inline (at this spot)"
msgstr "Inline (an dieser Stelle)"

#: blocks/seal/editor.js:78
msgid "Variant"
msgstr "Variante"

#: blocks/seal/editor.js:94
msgid "Profile slug (optional override)"
msgstr "Profil-Slug (optionaler Override)"

#: blocks/seal/editor.js:96
msgid "Default: slug from Settings → RatingStar"
msgstr "Standard: Slug aus Einstellungen → RatingStar"

#: blocks/seal/editor.js:104
msgid "Static image (no JavaScript)"
msgstr "Statisches Bild (ohne JavaScript)"

#: blocks/seal/editor.js:114
msgid "Placement"
msgstr "Platzierung"

#: blocks/seal/editor.js:117
msgid "Inline renders the card right here; a corner floats it fixed on screen (the former floating badge)."
msgstr "Inline rendert die Karte an genau dieser Stelle; eine Ecke lässt sie fest am Bildschirmrand schweben (das frühere Floating-Badge)."

#: blocks/seal/editor.js:128
msgid "Optional appearance overrides for this embed, as key=value pairs — e.g. pc-color=gold car-count=4. Copy them from the embed generator in your RatingStar portal; the data- prefix may be included or left out."
msgstr "Optionale Darstellungs-Overrides für dieses Embed als key=value-Paare — z. B. pc-color=gold car-count=4. Kopieren Sie sie aus dem Embed-Generator in Ihrem RatingStar-Portal; das data--Präfix kann mitkopiert oder weggelassen werden."

